# ============================================================================
# Atlas — optional environment variables
# ----------------------------------------------------------------------------
# Local Ollama does not need a VITE_* AI key, Vercel AI proxy, or hosted key.
# Select Ollama in the in-app AI setup panel. For local models, set
# OLLAMA_ORIGINS on the Ollama process itself (see DEPLOYMENT.md).
# ============================================================================

# --- Frontend (Vite: public Supabase URL + anon key only) --------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only Supabase values for /api/invoke-llm JWT verification -------
# Use the project URL, not a Postgres connection string. Never add a service
# role key to Vite or this file.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional hosted provider (used only after selecting Hosted in AI setup) -
# Hosted providers can impose their own pricing, quotas, and HTTP 429 limits.
# Keys stay server-side. Do not prefix them with VITE_.
# Set LLM_PROVIDER if you configure more than one key; otherwise the server
# chooses the first available provider. Supported values: gemini, nararouter,
# groq, openrouter, openai, anthropic. Set nararouter explicitly to use it
# instead of an already-configured Gemini key.
#LLM_PROVIDER=nararouter
#GEMINI_API_KEY=
#NARAROUTER_API_KEY=
#NARAROUTER_MODEL=agnes-3-flash
#NARAROUTER_BASE_URL=https://router.bynara.id/v1
#GROQ_API_KEY=
#OPENROUTER_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# Optional hosted-model overrides.
#GEMINI_MODEL=gemini-flash-latest
#GROQ_MODEL=llama-3.3-70b-versatile
#OPENROUTER_MODEL=openrouter/auto
#OPENAI_MODEL=gpt-4o
#ANTHROPIC_MODEL=claude-sonnet-4-6
#GROQ_BASE_URL=https://api.groq.com/openai/v1
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_BASE_URL=https://api.openai.com/v1

# Set to "true" only for local experimentation without Supabase login.
#LLM_ALLOW_ANON=true
