# ============================================================================
# Atlas — environment variables
# ----------------------------------------------------------------------------
# LOCAL DEV: copy this file to `.env.local` and fill in the values.
# VERCEL:    Settings -> Environment Variables (see DEPLOYMENT.md, Part 3).
# ============================================================================

# --- Frontend (Vite: must be VITE_-prefixed; embedded at build time) --------
# Supabase project: Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server (/api/invoke-llm on Vercel; never exposed to the browser) -------
# Use the same values as above (kept separate in case they ever diverge).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Which provider powers the AI (gemini | openai | anthropic). Optional if you
# set exactly one API key below.
LLM_PROVIDER=gemini

# At least ONE provider key is required for real AI output. Recommended: Gemini
# (also enables internet-grounded college research in the Knowledge Base).
GEMINI_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown in DEPLOYMENT.md).
#GEMINI_MODEL=gemini-2.5-flash
#OPENAI_MODEL=gpt-4o
#ANTHROPIC_MODEL=claude-sonnet-4-5
# For OpenAI-compatible endpoints (e.g. Azure/OpenRouter gateways):
#OPENAI_BASE_URL=https://api.openai.com/v1

# Set to "true" only for local experimentation without login (disables the
# Supabase JWT check on the AI endpoint).
#LLM_ALLOW_ANON=true
