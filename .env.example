# ============================================================================
# Atlas — environment variables
# ----------------------------------------------------------------------------
# AI runs on NaraRouter through the server-side /api/invoke-llm function. The
# key is never a VITE_* variable and never reaches the browser. With no key set,
# Atlas runs in labeled demo mode and refuses to save AI output.
# ============================================================================

# --- Frontend (Vite: public Supabase URL + anon key only) --------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only Supabase values for /api/invoke-llm JWT verification -------
# Use the project URL, not a Postgres connection string. Never add a service
# role key to Vite or this file.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Local AI with Ollama (optional, opt-in) --------------------------------
# Set LLM_PROVIDER=ollama to run a model on THIS computer instead of NaraRouter.
# The Atlas server calls Ollama; the browser never does, and no key is needed.
# Install Ollama, run `ollama pull qwen3:8b`, keep Ollama running, then restart
# `npm run dev`. Ollama is never selected automatically.
#
# A step-by-step local setup is in LOCAL_SETUP.md. Ollama works in local
# development only: a Vercel deployment cannot reach your computer.
#LLM_PROVIDER=ollama
#OLLAMA_BASE_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=qwen3:8b
# Context window requested from Ollama (tokens). A prompt that does not fit is
# refused with a message; it is never cut silently. Raise it if the machine has
# RAM; a reasoning model keeps its trace inside this same window, so 32768 suits
# qwen3:8b. Ollama reduces a larger value to the model's own limit, and Atlas
# says so in AI setup.
#OLLAMA_NUM_CTX=16384

# Reasoning ("thinking") models — qwen3:8b is one — write a chain of thought
# before the answer. That is where the depth comes from, so Atlas asks for it.
#   on   (default) ask the model to reason, even if a global `/set nothink`
#                   or a Modelfile switched it off
#   off             answer directly: faster and shallower
#   auto            send nothing and let the model's own default decide
#   low|medium|high|max   for models with effort levels (gpt-oss)
# A model with no reasoning control is never sent one (Ollama answers 400), and
# a model that refuses is retried once without it.
#OLLAMA_THINK=on
# Output tokens reserved for the reasoning trace, ON TOP of the answer. Ollama
# counts both against the same budget, so an answer-sized cap alone is spent on
# reasoning and the answer comes back empty.
#OLLAMA_THINK_BUDGET=8192
# Qwen3 and DeepSeek-R1 both publish Temperature 0.6 / TopP 0.95 / TopK 20 for
# thinking mode, with an explicit "do not use greedy decoding". Atlas raises a
# colder requested temperature (a review asks for 0.15) to this floor while
# reasoning is on, and reports the change in the response. Set 0 to keep
# Atlas's numbers exactly as they are.
#OLLAMA_MIN_TEMPERATURE=0.6
#OLLAMA_TOP_P=0.95
#OLLAMA_TOP_K=20
# Wall-clock ceiling for one call. Deep reasoning on a laptop CPU can take many
# minutes, so this is generous by design (Node's own fetch would give up at 5).
#OLLAMA_TIMEOUT_MS=1800000
# How long Ollama keeps the model in memory between AI actions (Ollama's own
# default is 5 minutes, which reloads gigabytes from disk after every pause).
#OLLAMA_KEEP_ALIVE=30m

# --- Optional hosted provider (used only after selecting Hosted in AI setup) -
# Hosted providers can impose their own pricing, quotas, and HTTP 429 limits.
# Keys stay server-side. Do not prefix them with VITE_.
# Set LLM_PROVIDER if you configure more than one key; otherwise the server
# chooses the first available provider. Supported values: nararouter, ollama,
# gemini, groq, openrouter, openai, anthropic. Set nararouter explicitly to use
# it instead of an already-configured Gemini key. ollama is never auto-selected.
#LLM_PROVIDER=nararouter
#GEMINI_API_KEY=
#NARAROUTER_API_KEY=
#NARAROUTER_MODEL=agnes-3-flash
#NARAROUTER_BASE_URL=https://router.bynara.id/v1
#GROQ_API_KEY=
#OPENROUTER_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# Optional hosted-model overrides.
#GEMINI_MODEL=gemini-flash-latest
#GROQ_MODEL=llama-3.3-70b-versatile
#OPENROUTER_MODEL=openrouter/auto
#OPENAI_MODEL=gpt-4o
#ANTHROPIC_MODEL=claude-sonnet-4-6
#GROQ_BASE_URL=https://api.groq.com/openai/v1
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_BASE_URL=https://api.openai.com/v1

# Set to "true" only for local experimentation without Supabase login.
#LLM_ALLOW_ANON=true
